{
  "name": "clidable",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "CLI coding agents for everyone — checkpoints, preview, plugin/skill/MCP management, AI teams.",
  "homepage": "https://github.com/openclide/clidable",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclide/clidable.git"
  },
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "build": "bun scripts/build.ts",
    "build:compile": "bun scripts/build.ts --compile",
    "start": "cd dist && bun index.js",
    "test": "bun test server shared web",
    "docs:build": "bun scripts/build-docs-site.ts",
    "docs:serve": "bun scripts/build-docs-site.ts --serve",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/lint": "6.9.6",
    "@codemirror/merge": "6.12.1",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vscode-keymap": "6.0.2",
    "@uiw/react-codemirror": "4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "add-mcp": "^1.10.4",
    "env-paths": "^4.0.0",
    "ignore": "7.0.5",
    "plugins": "^1.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "skills": "^1.5.9"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bun-plugin-tailwind": "^0.1.2",
    "marked": "^18.0.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "trustedDependencies": [
    "@tauri-apps/cli",
    "bun"
  ]
}
