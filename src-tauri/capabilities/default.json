{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main window and dynamically-opened workspace windows.",
  "windows": ["main", "clidable-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:default",
    "opener:default"
  ]
}
