{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clidable",
  "version": "../package.json",
  "identifier": "dev.clidable.app",

  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun scripts/build-sidecar.ts",
    "devUrl": "http://127.0.0.1:7878",
    "frontendDist": "../dist/web"
  },

  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "http://127.0.0.1:7878/",
        "visible": false,
        "title": "",
        "maximized": true,
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 15, "y": 28 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/clidable-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "GUI for CLI coding agents",
    "longDescription": "Clidable wraps Claude Code, Codex CLI, Antigravity CLI, and friends in a beautiful UI with checkpoints, multi-agent terminals, and project preview."
  }
}
